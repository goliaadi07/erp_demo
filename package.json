{
  "name": "threadline-garment-erp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --config client/vite.config.js --host 127.0.0.1",
    "build": "node node_modules/vite/bin/vite.js build --config client/vite.config.js",
    "start": "node server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.5",
    "@vitejs/plugin-react": "^5.0.4"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
